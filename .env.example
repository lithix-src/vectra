# =============================================================================
# VECTRA — Standardized Environment Configuration (.env.example)
# Copy to .env for local overrides; defaults work out-of-the-box.
# =============================================================================

# 1. Database Layer (PostgreSQL 17 + pgvector + Apache AGE or SQLite Fallback)
# For Rancher Desktop Postgres 17 container:
# VECTRA_DATABASE_URL=postgresql+asyncpg://vectra:vectra_secure_password@localhost:5432/vectra_intel
# Default zero-daemon fallback:
VECTRA_DATABASE_URL=sqlite+aiosqlite:///./packages/db/vectra_intel.db

# 2. Multi-Tenant KMS Envelope Encryption Master Key (32+ char secret)
VECTRA_KMS_MASTER_KEY=vectra-enterprise-kms-master-kek-2026-erik-advisory-os

# 3. Default Tenant Context (Row-Level Security Scope)
VECTRA_DEFAULT_USER_ID=erik
VECTRA_DEFAULT_ORG_ID=vectra-advisory

# 4. Temporal.io Orchestration & Redis Cache
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=vectra-intelligence-queue
REDIS_URL=redis://localhost:6379/0

# 5. API & Web Endpoints
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
